.playwright-mcp/
.DS_Store
# No trailing slash: a git worktree links node_modules rather than holding a
# directory, and a trailing slash would not match the symlink.
node_modules

# GM library customizations live in library/, which is not committed apart from
# the tracked empty campaign-library.json the app loads at startup.
# (src/library/ is source code, not GM data — keep it tracked.)
library/*
!library/campaign-library.json
!src/library/
claude.md
PLAN.md

# Build artifacts
dist/
