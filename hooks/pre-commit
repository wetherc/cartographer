#!/bin/sh
# Pre-commit gate: lint, unit tests, and the real typecheck must all pass.
# This directory is versioned; point git at it once per clone with:
#   git config core.hooksPath hooks
# Every tool runs through `pnpm exec`, so the hook uses the versions that the
# lockfile pins and that `pnpm install` put in node_modules. Nothing is fetched
# from the registry at commit time. Run `pnpm install` once per clone first.
set -e
cd "$(git rev-parse --show-toplevel)"

# Auto-format staged code before the checks run. Prettier is a pinned dev
# dependency; scope (js/ts/css only) comes from .prettierignore. The
# re-add means a partially staged file gets its unstaged hunks staged too —
# stash working-tree changes first if that matters for a given commit.
echo "pre-commit: prettier"
staged=$(git diff --cached --name-only --diff-filter=ACMR -- '*.js' '*.ts' '*.css')
if [ -n "$staged" ]; then
  echo "$staged" | tr '\n' '\0' | xargs -0 pnpm exec prettier --write --ignore-unknown
  echo "$staged" | tr '\n' '\0' | xargs -0 git add
fi

# The developer guide is generated from the source tree, so a commit that
# changes the tree regenerates it and stages the result. This keeps its
# counts, snippets, and line references from drifting out of date.
if git diff --cached --name-only --diff-filter=ACMR | grep -qE '^(src/|tests/|package\.json|scripts/dev-guide/|scripts/build-dev-guide\.mjs)'; then
  echo "pre-commit: dev guide"
  node scripts/build-dev-guide.mjs
  git add docs/dev-guide.html
fi

echo "pre-commit: eslint"
pnpm exec eslint .

echo "pre-commit: unit tests"
# The reporter prints one line per module, and the tests of a failure only.
node --test \
  --test-reporter=./tests/reporters/module-tree.js --test-reporter-destination=stdout \
  tests/*.test.js

echo "pre-commit: typecheck"
pnpm exec tsc --noEmit

# Benchmark check, informational only. It times the size-sensitive pure paths
# at a large world size and flags any path over its budget. A breach prints a
# loud warning but never blocks the commit. It runs only when the commit
# touches src/, because nothing else can change these numbers.
if git diff --cached --name-only --diff-filter=ACMR | grep -q '^src/'; then
  echo "pre-commit: bench (informational, never blocks)"
  node bench/commit-bench.js || echo "pre-commit: bench over budget; commit proceeds"
fi

echo "pre-commit: all checks passed"
