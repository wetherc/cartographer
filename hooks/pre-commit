#!/bin/sh
# Pre-commit gate: lint, unit tests, and the real typecheck must all pass.
# This directory is versioned; point git at it once per clone with:
#   git config core.hooksPath hooks
# Note: the typecheck must be `pnpm --package=typescript dlx tsc` — the bare
# `pnpx tsc` resolves npm's placeholder package and checks nothing (see README).
set -e
cd "$(git rev-parse --show-toplevel)"

# Auto-format staged code before the checks run. Prettier is fetched on demand
# like the other tools; scope (js/ts/css only) comes from .prettierignore. The
# re-add means a partially staged file gets its unstaged hunks staged too —
# stash working-tree changes first if that matters for a given commit.
echo "pre-commit: prettier"
staged=$(git diff --cached --name-only --diff-filter=ACMR -- '*.js' '*.ts' '*.css')
if [ -n "$staged" ]; then
  echo "$staged" | tr '\n' '\0' | xargs -0 pnpm --package=prettier dlx prettier --write --ignore-unknown
  echo "$staged" | tr '\n' '\0' | xargs -0 git add
fi

# The developer guide is generated from the source tree, so a commit that
# changes the tree regenerates it and stages the result. This keeps its
# counts, snippets, and line references from drifting out of date.
if git diff --cached --name-only --diff-filter=ACMR | grep -qE '^(src/|tests/|package\.json|scripts/dev-guide/|scripts/build-dev-guide\.mjs)'; then
  echo "pre-commit: dev guide"
  node scripts/build-dev-guide.mjs
  git add docs/dev-guide.html
fi

echo "pre-commit: eslint"
pnpm --package=eslint dlx eslint .

echo "pre-commit: unit tests"
# TEST_QUIET keeps the gate to one line per module. A failure still prints its
# tests and its error.
TEST_QUIET=1 node --test \
  --test-reporter=./tests/reporters/module-tree.js --test-reporter-destination=stdout \
  tests/*.test.js

echo "pre-commit: typecheck"
pnpm --package=typescript dlx tsc --noEmit

echo "pre-commit: all checks passed"
