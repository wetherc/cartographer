{
  "name": "campaign-builder",
  "version": "1.10.0",
  "description": "A self-contained suite for creating and managing the world of a D&D (or equivalent) campaign.",
  "main": "src/main.js",
  "scripts": {
    "test": "node --test --test-reporter=./tests/reporters/module-tree.js --test-reporter-destination=stdout tests/*.test.js",
    "test:flat": "node --test tests/*.test.js",
    "coverage": "node --test --experimental-test-coverage --test-coverage-exclude='tests/**' --test-reporter=./tests/reporters/module-tree.js --test-reporter-destination=stdout tests/*.test.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "bench": "node bench/app-bench.js",
    "bench:pure": "node bench/pure-bench.js",
    "bench:scale": "node bench/scale-bench.js",
    "bench:commit": "node bench/commit-bench.js",
    "build": "node scripts/build.cjs",
    "dev": "node scripts/build.cjs --watch",
    "deploy": "bash scripts/deploy.sh",
    "guide": "node scripts/build-dev-guide.mjs",
    "guide:check": "node scripts/build-dev-guide.mjs --check"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.17.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "typescript": "^7.0.2"
  }
}
